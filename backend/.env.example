PORT=5100
NODE_ENV=development

# Portal's own database — admins, org registry, audit log. No CRM data.
MONGODB_URI=mongodb://localhost:27017/root_sales_crm

JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

CLIENT_URL=http://localhost:3100

ROOT_ADMIN_NAME=Root Admin
ROOT_ADMIN_EMAIL=
ROOT_ADMIN_PASSWORD=

# ── Org registry ─────────────────────────────────────────────────────────
# MONGODB_URIs must include ?authSource=admin and should use read-only users.
# SSO secrets are generated in Phase 2 and must match each CRM's own env.
DELTA_APP_URL=
DELTA_API_URL=
DELTA_MONGODB_URI=
DELTA_SSO_SECRET=

BANGLORE_APP_URL=
BANGLORE_API_URL=
BANGLORE_MONGODB_URI=
BANGLORE_SSO_SECRET=

DRAW_APP_URL=
DRAW_API_URL=
DRAW_MONGODB_URI=
DRAW_SSO_SECRET=

BASE_CURRENCY=AED
INR_TO_AED=0.0435
