PORT=5100
NODE_ENV=development

# Portal's own database — admins, org registry, audit log. No CRM data.
MONGODB_URI=mongodb://localhost:27017/root_sales_crm

JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated. MUST include the exact scheme+host the browser uses.
# Production example:
#   CLIENT_URL=https://root-sales-crm.deltainstitutions.com
CLIENT_URL=http://localhost:3100

ROOT_ADMIN_NAME=Root Admin
ROOT_ADMIN_EMAIL=
ROOT_ADMIN_PASSWORD=

# ── The systems this portal fronts ───────────────────────────────────────
#
# Every system is configured here and nowhere else. These used to be copied
# into the database and edited from a Registry screen, which meant two sources
# of truth and the screen edited the copy — change a secret here and the portal
# kept the stale one; change it there and the next deploy put the old one back.
#
# The variable names are the system's code in upper case, with dashes as
# underscores: finance-hq becomes FINANCE_HQ_*. Adding a system needs no code
# change, only its variables.
#
#   _APP_URL         where to send a browser
#   _API_URL         where to send a service call
#   _MONGODB_URI     read-only user, with ?authSource=admin (CRMs only, for
#                    the group report and the daily tracker)
#   _SSO_SECRET      shared secret, and it must match that system's own env
#   _SERVICE_EMAIL   the account the portal signs in as for a root admin
#   _REMOTE_ORG_ID   which organization inside that system, where it holds
#                    more than one (the two finance orgs; blank for a CRM)
#
# Anything left blank means that system is unavailable and says so, rather
# than failing later with a message nobody can act on. The Systems screen
# names whatever is still missing.
#
# Moving an existing deployment across:
#   bun run src/scripts/registry-to-env.ts        prints these from the database
#   bun run src/scripts/registry-to-env.ts --clean  removes them once it works

DELTA_APP_URL=
DELTA_API_URL=
DELTA_MONGODB_URI=
DELTA_SSO_SECRET=
DELTA_SERVICE_EMAIL=

BANGLORE_APP_URL=
BANGLORE_API_URL=
BANGLORE_MONGODB_URI=
BANGLORE_SSO_SECRET=
BANGLORE_SERVICE_EMAIL=

DRAW_APP_URL=
DRAW_API_URL=
DRAW_MONGODB_URI=
DRAW_SSO_SECRET=
DRAW_SERVICE_EMAIL=

# Finance is one server holding both organizations, so these two share an
# address and are told apart by REMOTE_ORG_ID.
FINANCE_HQ_APP_URL=
FINANCE_HQ_API_URL=
FINANCE_HQ_SSO_SECRET=
FINANCE_HQ_SERVICE_EMAIL=
FINANCE_HQ_REMOTE_ORG_ID=

FINANCE_BANGLORE_APP_URL=
FINANCE_BANGLORE_API_URL=
FINANCE_BANGLORE_SSO_SECRET=
FINANCE_BANGLORE_SERVICE_EMAIL=
FINANCE_BANGLORE_REMOTE_ORG_ID=

# HRMS_API_URL is set in the HRMS section below, which the employee import
# also uses — one address, named once.
HRMS_APP_URL=
HRMS_SSO_SECRET=
HRMS_SERVICE_EMAIL=

BASE_CURRENCY=AED
INR_TO_AED=0.0435

# ── HRMS, where a person first exists ──
#
# HR creates the employee in HRMS; the portal reads them from there rather than
# being a second place the same staff are typed in. Two lists of one workforce
# drift, and since email is what every handoff matches on, a second spelling of
# an address is somebody who cannot sign in.
#
# The same signed scheme finance uses, so the client id and secret are the ones
# already issued for this estate. HRMS_ORG_ID is the organization inside HRMS
# whose staff this portal serves.
#
# Unset, the import is simply unavailable and says so.
HRMS_API_URL=
HRMS_CLIENT_ID=
HRMS_INTEGRATION_SECRET=
HRMS_ORG_ID=
